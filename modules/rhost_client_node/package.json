{
  "name": "@hyper-hyper-space/hhs3_rhost_client_node",
  "version": "0.1.0",
  "description": "Reaches an rhost host from a Node app: its run/rhost.sock for live state, its projection and host.json for keys and events",
  "type": "module",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "TS_NODE_PROJECT=./tsconfig.test.json node --import ../../register.mjs ./test/run_tests.ts",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist test-build"
  },
  "author": "Santiago Bazerque",
  "license": "MIT",
  "dependencies": {
    "@hyper-hyper-space/hhs3_crypto": "^0.1.0",
    "@hyper-hyper-space/hhs3_mvt": "^0.1.0",
    "@hyper-hyper-space/hhs3_rhost_client": "^0.1.0",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@hyper-hyper-space/hhs3_rdb": "^0.1.0",
    "@hyper-hyper-space/hhs3_rdb_runtime": "^0.1.0",
    "@hyper-hyper-space/hhs3_rhost": "^0.1.0",
    "@hyper-hyper-space/hhs3_rhost_node": "^0.1.0",
    "@hyper-hyper-space/hhs3_rpack": "^0.1.0",
    "@hyper-hyper-space/hhs3_util": "^0.1.0",
    "@types/node": "^22.2.0",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  }
}
