{
  "name": "@hyper-hyper-space/hhs3_rdb_adapter_idb",
  "version": "0.1.0",
  "description": "IndexedDB MaterializationTarget for the HHSv3 rdb_adapter",
  "type": "module",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "node --import ../../register.mjs ./test/run_tests.ts",
    "test:projection:fast": "node --import ../../register.mjs ./test/run_tests.ts PROJECTION --profile fast",
    "test:projection:full": "node --import ../../register.mjs ./test/run_tests.ts PROJECTION --profile full",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "author": "Santiago Bazerque",
  "license": "MIT",
  "dependencies": {
    "@hyper-hyper-space/hhs3_crypto": "^0.1.0",
    "@hyper-hyper-space/hhs3_json": "^0.1.0",
    "@hyper-hyper-space/hhs3_mvt": "^0.1.0",
    "@hyper-hyper-space/hhs3_rdb": "^0.1.0",
    "@hyper-hyper-space/hhs3_rdb_adapter": "^0.1.0"
  },
  "devDependencies": {
    "@hyper-hyper-space/hhs3_rdb_adapter_test": "^0.1.0",
    "@hyper-hyper-space/hhs3_util": "^0.1.0",
    "@types/node": "^22.2.0",
    "fake-indexeddb": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  }
}
